# Postgres (docker compose up -d postgres -> localhost:5434)
DATABASE_URL=postgresql://listingarena:listingarena@localhost:5434/listingarena
POSTGRES_PASSWORD=listingarena
# Publisher: rows per POST (app accepts any size; keep < 1000)
PUBLISH_CHUNK=500

# Protected ListingArena import endpoint
LISTINGARENA_API_URL=https://listingarena.com/api/listings
LISTINGARENA_ADMIN_TOKEN=replace-with-the-same-secret-as-ADMIN_TOKEN

# Configure only approved official JSON APIs. The job skips providers without a URL.
# Each endpoint receives county, state, and fips query parameters.
# REALTOR_API_URL=
# REALTOR_API_KEY=
# REALTOR_RECORDS_PATH=data
# REALTOR_NEXT_CURSOR_PATH=next_cursor
# REDFIN_API_URL=
# REDFIN_API_KEY=
# REDFIN_RECORDS_PATH=data
# REDFIN_NEXT_CURSOR_PATH=next_cursor
# HOMES_API_URL=
# HOMES_API_KEY=
# HOMES_RECORDS_PATH=data
# HOMES_NEXT_CURSOR_PATH=next_cursor

# ProxyRotator gateway (proxyrotator.com dashboard -> gateway catalogue). Values only in .env, never committed.
# PROXYROTATOR_GATEWAY=          # host:port, e.g. gateway.proxyrotator.com:11000
# PROXYROTATOR_USERNAME=
# PROXYROTATOR_PASSWORD=
# PROXYROTATOR_SCHEME=           # http (default) or socks5h
# PROXYROTATOR_DIRECT_FALLBACK=  # 1 = go direct when budget reached / all endpoints retired; 0 = skip
# PROXY_MAX_THREADS=             # GLOBAL proxied in-flight cap across all processes (default 10, max 10)
# PROXY_SLOT_DIR=                # default data/proxy_slots
# PROXY_BUDGET_GB=               # bandwidth budget per period (default 150)
# PROXY_DAILY_GB=                # per-day cap, resets local midnight (default 5; plan pauses at 10)
# PROXY_RESET_DATE=              # YYYY-MM-DD renewal day (default 2026-11-09)
# PROXY_USAGE_FILE=              # default data/proxy_usage.json
# REDFIN_USE_PROXYROTATOR=       # hybrid (default) | proxy | off
# REALTOR_USE_PROXYROTATOR=      # hybrid (default) | proxy | off
